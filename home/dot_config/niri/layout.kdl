layout {
	preset-column-widths {
		proportion 0.3333
		proportion 0.5
		proportion 0.6667
		proportion 1.0
	}

	preset-window-heights {
		proportion 0.3333
		proportion 0.5
		proportion 0.6667
		proportion 1.0
	}

	default-column-width { proportion 1.0; }

	focus-ring {
		width 2
		active-gradient from="#FFB4A2" to="#e5989B" angle=45 in="oklch longer hue"
	}

	tab-indicator {
		active-color "#0bffd6"
		inactive-color "#000000"
		inactive-gradient from="#FF00FF" to="#00FFFF" angle=200 in="oklch longer hue"
	}

	shadow {
		on
		softness 30
		spread 5
	}

	struts {
		right 10
		left 10
	}

}
