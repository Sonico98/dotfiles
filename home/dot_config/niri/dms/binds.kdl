binds {
    Ctrl+Alt+Delete hotkey-overlay-title="Task Manager" { spawn "dms" "ipc" "call" "processlist" "focusOrToggle"; }
    Ctrl+F1 hotkey-overlay-title="Lower Brightness" allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "decrement" "5" ""; }
    Ctrl+F2 allow-when-locked=true hotkey-overlay-title="Raise Brightness" { spawn "dms" "ipc" "call" "brightness" "increment" "5" ""; }
    Ctrl+Print hotkey-overlay-title="Quick Screen Record" { spawn "dms" "ipc" "call" "screenRecorder" "toggleRecording"; }
    Ctrl+XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Lower Application Volume" { spawn "dms" "ipc" "call" "mpris" "decrement" "3"; }
    Ctrl+XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Raise Application Volume" { spawn "dms" "ipc" "call" "mpris" "increment" "3"; }
    Mod+C hotkey-overlay-title="Colorpicker" { spawn "sh" "-c" "dms color pick -a"; }
    Mod+Ctrl+space allow-when-locked=true hotkey-overlay-title="Toggle Play/Pause" { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    Mod+KP_Divide allow-when-locked=true hotkey-overlay-title="Lower volume" { spawn "dms" "ipc" "call" "audio" "decrement" "3"; }
    Mod+KP_Multiply allow-when-locked=true hotkey-overlay-title="Raise volume" { spawn "dms" "ipc" "call" "audio" "increment" "3"; }
    Ctrl+Mod+KP_Divide allow-when-locked=true hotkey-overlay-title="Play Prev" { spawn "dms" "ipc" "call" "mpris" "previous"; }
    Ctrl+Mod+KP_Multiply allow-when-locked=true hotkey-overlay-title="Play Next" { spawn "dms" "ipc" "call" "mpris" "next"; }
    Mod+N hotkey-overlay-title="Notification Center" { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+O hotkey-overlay-title="Power Menu: Toggle" { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    Mod+Scroll_Lock hotkey-overlay-title="Settings" { spawn "dms" "ipc" "call" "settings" "focusOrToggle"; }
    Mod+V hotkey-overlay-title="Clipboard Manager" { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Lower Volume" { spawn "dms" "ipc" "call" "audio" "decrement" "3"; }
    XF86AudioMicMute allow-when-locked=true hotkey-overlay-title="Mute Microphone" { spawn "dms" "ipc" "call" "audio" "micmute"; }
    XF86AudioMute allow-when-locked=true hotkey-overlay-title="Mute Audio" { spawn "dms" "ipc" "call" "audio" "mute"; }
    XF86AudioNext allow-when-locked=true hotkey-overlay-title="Play Next" { spawn "dms" "ipc" "call" "mpris" "next"; }
    XF86AudioPause allow-when-locked=true hotkey-overlay-title="Toggle Play/Pause" { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPlay allow-when-locked=true hotkey-overlay-title="Toggle Play/Pause" { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPrev allow-when-locked=true hotkey-overlay-title="Play Prev" { spawn "dms" "ipc" "call" "mpris" "previous"; }
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Raise Volume" { spawn "dms" "ipc" "call" "audio" "increment" "3"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Lower Brightness" { spawn "dms" "ipc" "call" "brightness" "decrement" "5" ""; }
    XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title="Raise Brightness" { spawn "dms" "ipc" "call" "brightness" "increment" "5" ""; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+Down { move-column-to-workspace-down; }
    Mod+Ctrl+I { move-column-to-workspace-up; }
    Mod+Ctrl+U { move-column-to-workspace-down; }
    Mod+Ctrl+Up { move-column-to-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up { move-workspace-up; }
    Shift+Print { screenshot-window; }
    Alt+XF86Launch1 { screenshot-window; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma { switch-preset-window-height; }
    Mod+Ctrl+H { move-window-to-monitor-left; }
    Mod+Ctrl+J { move-window-to-monitor-down; }
    Mod+Ctrl+K { move-window-to-monitor-up; }
    Mod+Ctrl+L { move-window-to-monitor-right; }
    Mod+E hotkey-overlay-title="Cast focused window" { spawn-sh "niri msg action set-dynamic-cast-window --id $(niri msg -j focused-window | jq .id)"; }
    Mod+End { focus-column-last; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+F { fullscreen-window; }
    Mod+H { focus-column-left; }
    Mod+Home { focus-column-first; }
    Mod+J hotkey-overlay-title="Focus down" { focus-window-or-monitor-down; }
    Mod+K hotkey-overlay-title="Focus Up" { focus-window-or-monitor-up; }
    Mod+L { focus-column-right; }
    Mod+Left { focus-column-left; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Period { switch-preset-column-width; }
    Mod+Right { focus-column-right; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+End { move-column-to-last; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+Shift+F { maximize-column; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+J { move-column-to-monitor-down; }
    Mod+Shift+K { move-column-to-monitor-up; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Q repeat=false { close-window; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp { focus-column-left; }
    Mod+Shift+space { toggle-window-floating; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+space hotkey-overlay-title="Switch Floating/Tiling Focus" { switch-focus-between-floating-and-tiling; }
    Mod+Shift+P { power-off-monitors; }
    Print { screenshot show-pointer=false; }
    Ctrl+Shift+Print { screenshot-screen; }
    XF86Launch1 { screenshot; }
    Mod+Shift+E { quit; }
    Mod+R hotkey-overlay-title="Launch Rofi" { spawn "rofi" "-theme-show-icons" "-show" "drun" "-modi" "drun#run" "-drun-display-format" "{name}"; }
    Mod+Return hotkey-overlay-title="Open Terminal" { spawn "niri-scratchpad" "target" "--spawn" "kitty" "appid" "kitty"; }
    Mod+Shift+D hotkey-overlay-title="Open Vesktop" { spawn "niri-scratchpad" "target" "--spawn" "vesktop" "appid" "vesktop"; }
    Mod+Shift+Return hotkey-overlay-title="Open New Terminal Window" { spawn "kitty"; }
    Mod+Shift+S hotkey-overlay-title="Open Telegram" { spawn "niri-scratchpad" "target" "--spawn" "materialgram" "appid" "io.github.kukuruzka165.materialgram"; }
	Mod+S { spawn "nsticky" "sticky" "toggle-active"; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Tab repeat=false { toggle-overview; }
}
